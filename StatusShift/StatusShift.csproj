<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.6.0</Version>
    <Author>XozaShadow</Author>
    <Name>StatusShift</Name>
    <Punchline>Shift search comment and online status by zone, activity, and schedule.</Punchline>
    <Description>Rules change your search comment, online status, and optional commands from zone, duty, activity, job, world, and schedule.</Description>
    <RepoUrl>https://github.com/XozaShadow/StatusShift</RepoUrl>
    <PackageProjectUrl>https://github.com/XozaShadow/StatusShift</PackageProjectUrl>
    <IconUrl>https://raw.githubusercontent.com/XozaShadow/StatusShift/main/images/icon.png</IconUrl>
    <Tags>status;search;comment;roleplay;schedule;zone</Tags>
    <InternalName>StatusShift</InternalName>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
